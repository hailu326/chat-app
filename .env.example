# Copy this file to .env and fill in YOUR values. Never commit .env.
PORT=3000
CONN_STRING=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/chat-app
# At least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use a DIFFERENT secret on your online server than on your own computer.
JWT_SECRET=
# development (your computer) or production (online server: Secure cookies, HTTPS-only settings)
NODE_ENV=development
# Biggest file one user can send, in MB. Files are stored in MongoDB, so on a free
# Atlas database (512 MB) a smaller limit such as 10 is wise.
MAX_UPLOAD_MB=25
# Optional: extra allowed browser origins, comma separated (only if the page is on another domain)
# CLIENT_ORIGIN=https://chat.example.com
# Optional: set to 1 if you run behind a proxy but NODE_ENV is not production
# TRUST_PROXY=1
